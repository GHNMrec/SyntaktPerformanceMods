#!/bin/sh
# Refuse commits that contain Elektron firmware (see LEGAL.md).
# Switch it on once per clone:  git config core.hooksPath tools/hooks
for py in python3 python py; do
    if command -v "$py" >/dev/null 2>&1 && "$py" -c "import sys" >/dev/null 2>&1; then
        exec "$py" "$(git rev-parse --show-toplevel)/tools/hooks/check_no_firmware.py"
    fi
done
echo "pre-commit: Python not found, cannot check for firmware" >&2
exit 1
